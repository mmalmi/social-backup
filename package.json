{
  "name": "social-backup",
  "version": "0.4.6",
  "homepage": "https://socialbackup.org/",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "build": "pnpm typecheck && node --experimental-strip-types scripts/build.ts",
    "package:stores": "pnpm test:release && python3 scripts/store-package.py",
    "build:site": "pnpm build && node --experimental-strip-types scripts/build-site.ts",
    "deploy:site": "node website/release-site.mjs --deploy",
    "publish:site:hashtree": "node website/release-site.mjs",
    "test": "node --experimental-strip-types --import ./test/web-locks.mjs --test test/*.test.ts test/*.test.mjs",
    "test:release": "node --experimental-strip-types scripts/test-release.ts",
    "test:browser": "node --experimental-strip-types scripts/browser-smoke.ts",
    "test:page": "node --experimental-strip-types scripts/browser-check.ts",
    "typecheck": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings --output machine"
  },
  "dependencies": {
    "@cashu/cashu-ts": "5.0.0-rc.4",
    "@cashu/coco-core": "2.0.0",
    "@cashu/coco-indexeddb": "2.0.0",
    "@hashtree/core": "https://github.com/mmalmi/hashtree/releases/download/hashtree-ts-runtime-v0.5.27/hashtree-core-0.4.0.tgz",
    "@hashtree/dexie": "https://github.com/mmalmi/hashtree/releases/download/hashtree-ts-runtime-v0.5.27/hashtree-dexie-0.1.13.tgz",
    "@hashtree/nostr": "https://github.com/mmalmi/hashtree/releases/download/hashtree-ts-runtime-v0.5.40/hashtree-nostr-0.2.7.tgz",
    "@hashtree/nostr-pubsub": "https://github.com/mmalmi/hashtree/releases/download/hashtree-ts-runtime-v0.5.27/hashtree-nostr-pubsub-0.1.9.tgz",
    "@iris/profile-events": "https://github.com/mmalmi/iris-kit/releases/download/runtime-v0.2.15/iris-profile-events-0.2.0.tgz",
    "@iris/svelte-ui": "https://github.com/mmalmi/iris-kit/releases/download/runtime-v0.2.6/iris-svelte-ui-0.1.2.tgz",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@scure/base": "2.4.0",
    "fflate": "0.8.3",
    "idb": "7.1.1",
    "linkedom": "0.18.15",
    "nostr-pubsub": "https://github.com/mmalmi/nostr-pubsub/releases/download/nostr-pubsub-ts-v0.5.32/nostr-pubsub-0.5.32.tgz",
    "nostr-pubsub-reconcile": "https://github.com/mmalmi/nostr-pubsub/releases/download/nostr-pubsub-reconcile-ts-v0.1.2/nostr-pubsub-reconcile-0.1.2.tgz",
    "nostr-tools": "2.25.2",
    "qrcode-generator": "2.0.4",
    "svelte": "5.57.3"
  },
  "devDependencies": {
    "@iris/release-tools": "https://github.com/mmalmi/iris-kit/releases/download/runtime-v0.2.12/iris-release-tools-0.1.2.tgz",
    "@types/node": "26.6.5",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.1",
    "fake-indexeddb": "6.2.5",
    "happy-dom": "20.14.6",
    "svelte-check": "4.7.7",
    "typescript": "5.9.3",
    "ws": "8.21.1"
  },
  "pnpm": {
    "overrides": {
      "@hashtree/nostr>@hashtree/collection": "https://github.com/mmalmi/hashtree/releases/download/hashtree-ts-runtime-v0.5.27/hashtree-collection-0.2.11.tgz",
      "@hashtree/nostr>@hashtree/core": "https://github.com/mmalmi/hashtree/releases/download/hashtree-ts-runtime-v0.5.27/hashtree-core-0.4.0.tgz",
      "@hashtree/nostr>@hashtree/index": "https://github.com/mmalmi/hashtree/releases/download/hashtree-ts-runtime-v0.5.27/hashtree-index-0.1.15.tgz",
      "@hashtree/nostr-pubsub>@hashtree/nostr": "https://github.com/mmalmi/hashtree/releases/download/hashtree-ts-runtime-v0.5.40/hashtree-nostr-0.2.7.tgz",
      "@hashtree/nostr-pubsub>nostr-pubsub": "https://github.com/mmalmi/nostr-pubsub/releases/download/nostr-pubsub-ts-v0.5.32/nostr-pubsub-0.5.32.tgz"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
